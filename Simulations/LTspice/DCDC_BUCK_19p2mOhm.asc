TEXT 1304 312 Left 2 !.param VIN_TEST=26\n.param VOUT_TEST=19\n.tran 0 40m 0 10n\n; Steady operation at approximately 3 A\n.meas tran Vavg AVG V(Vout) FROM 27m TO 29m\n.meas tran Vmax MAX V(Vout) FROM 27m TO 29m\n.meas tran Vmin MIN V(Vout) FROM 27m TO 29m\n.meas tran Vripple PARAM Vmax-Vmin\n.meas tran ILavg AVG I(L1) FROM 27m TO 29m\n.meas tran ILmax MAX I(L1) FROM 27m TO 29m\n.meas tran ILmin MIN I(L1) FROM 27m TO 29m\n.meas tran ILripple PARAM ILmax-ILmin\n; Load application and removal\n.meas tran Vdip MIN V(Vout) FROM 20m TO 25m\n.meas tran Vovershoot MAX V(Vout) FROM 30m TO 35m\n.meas tran ILpeak MAX I(L1) FROM 20m TO 31m\n; Driver supplies while loaded\n.meas tran DRVmin MIN V(DRVCC) FROM 27m TO 29m\n.meas tran DRVmax MAX V(DRVCC) FROM 27m TO 29m\n.meas tran BOOSTmin MIN V(BOOST,SW) FROM 27m TO 29m
TEXT 1320 272 Left 2 !.options plotwinsize=0
TEXT 1904 280 Left 2 !.meas tran Pin AVG (-VIN_TEST*I(V1)) FROM 27m TO 29m\n.meas tran Pout AVG (V(Vout)*(V(Vout)/VOUT_TEST+I(I1))) FROM 27m TO 29m\n.meas tran Efficiency PARAM 100*Pout/Pin\n.meas tran Ploss PARAM Pin-Pout
